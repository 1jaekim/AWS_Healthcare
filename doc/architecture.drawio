        <mxCell id="s3lake" value="S3 데이터 레이크 (KMS)&#10;raw/ rag/ trials/" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;size=10;" vertex="1" parent="1">
          <mxGeometry x="480" y="560" width="235" height="75" as="geometry" />
