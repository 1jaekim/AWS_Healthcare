        <mxCell id="ddb2" value="DynamoDB ApplicationStore&#10;스키마 · 지원서 세션 · 3층 캐시&#10;TTL 30일" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;size=10;" vertex="1" parent="1">
