        <mxCell id="bed" value="Bedrock Runtime&#10;temperature 0&#10;&#10;스키마 3층 · 값 추출&#10;배치 judge · A2A · 설명" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="745" y="430" width="215" height="100" as="geometry" />
        </mxCell>

        <mxCell id="gr" value="Bedrock Guardrail&#10;8u7lmyrfbox7 v1&#10;PII 차단 · 의료조언 억제" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
