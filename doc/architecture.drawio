  <diagram id="screens" name="2. 화면 흐름과 3상태">
    <mxGraphModel dx="1500" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="sh" value="화면 흐름 — 추천은 홈에서 한 번, 결과는 세 값" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;spacingLeft=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="40" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="회원가입&#10;/signup → /signup/verify&#10;Cognito 이메일 코드 확인" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="설문 4문항&#10;/signup/survey&#10;&#10;purpose · areas(관심분야)&#10;medication · allergy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="215" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="홈 /home&#10;첫 진입에서 추천 1회&#10;POST /recommendations/run&#10;&#10;승인 공고 전체를 기준과 대조&#10;병렬 실행 (ThreadPool, 최대 5)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="350" y="110" width="250" height="120" as="geometry" />
        </mxCell>

        <mxCell id="todo" value="미구현 — 추천 후보를 설문 areas 로 좁히는 부분&#10;&#10;설문 areas 는 CLINICAL_AREAS 고정 9개&#10;('당뇨 · 내분비', '심혈관', ...)&#10;공고 purpose 는 파서가 뽑은 condition 자유 텍스트&#10;('제2형 당뇨병')&#10;&#10;→ 두 어휘가 달라 동등 비교로 매칭되지 않는다.&#10;   매핑 방식 미결정 (키워드표 / 승인 시 LLM 분류 / 정렬 가중치)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="250" width="380" height="150" as="geometry" />
        </mxCell>

        <mxCell id="s4" value="공고 클릭" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="120" width="140" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="지원서 챗 /intake/:trialId&#10;&#10;1단계 서술 → 2단계 재질문(최대 5회)&#10;스키마 3층이 물을 항목을 정한다" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="900" y="100" width="270" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="판정 실행 /matching&#10;→ 결과 /results/:trialId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1230" y="105" width="220" height="80" as="geometry" />
        </mxCell>

        <mxCell id="dbl" value="알려진 중복 — /matching 과 /results 가 각각&#10;recommendations/run 을 다시 실행한다.&#10;지원서를 낸 공고 하나만 보면 되는데&#10;전체 후보를 재판정한다. 미정리." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1200" y="215" width="280" height="90" as="geometry" />
        </mxCell>

        <!-- 3상태 -->
        <mxCell id="v" value="결과 — 이 세 값만 노출한다" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=14;fontStyle=1;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="450" width="1420" height="230" as="geometry" />
        </mxCell>
        <mxCell id="v1" value="가능&#10;&#10;screening_decision = OK&#10;eligibility = ELIGIBLE&#10;&#10;기록으로 모든 기준이&#10;확인되었습니다" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="490" width="230" height="130" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="불가능&#10;&#10;screening_decision = NOT_OK&#10;eligibility = INELIGIBLE&#10;&#10;충족하지 못한 기준이&#10;있습니다" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="330" y="490" width="230" height="130" as="geometry" />
        </mxCell>
        <mxCell id="v3" value="판정불가&#10;&#10;screening_decision = UNKNOWN&#10;eligibility = NEEDS_MORE_EVIDENCE&#10;또는 REVIEW_REQUIRED&#10;&#10;기록만으로 확인되지 않은&#10;기준이 있습니다" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="580" y="490" width="245" height="130" as="geometry" />
        </mxCell>

        <mxCell id="rm" value="화면에서 제거한 것 — 추천 분석&#10;&#10;적합도 점수 (rank_score × 100)&#10;충족 N · 확인필요 N · 미충족 N&#10;selection_reason (&quot;A2A 근거 합의가...&quot;)&#10;recommendation_decision 비교 문구&#10;순위 (rank)&#10;&#10;점수는 기준별 고정 상수의 평균이라&#10;&quot;적합도 73&quot; 은 없는 정밀도를 만든다.&#10;기준 하나가 미해소면 결론은&#10;&quot;아직 판정할 수 없음&quot; 이고 73%가 아니다." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="855" y="490" width="290" height="180" as="geometry" />
        </mxCell>
        <mxCell id="kp" value="남긴 것 — 판정 근거&#10;&#10;기준별 상태와 이유&#10;근거 출처 ID (encounter_id)&#10;판단 검증 7항목 실패 내역&#10;다음 질문&#10;&#10;헤드라인은 세 값,&#10;이유는 펼쳐서 본다.&#10;&quot;판정불가&quot; 가 왜 판정불가인지&#10;답할 수단이 없으면 세 값만&#10;보여주는 것이 더 불친절하다." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1170" y="490" width="290" height="180" as="geometry" />
        </mxCell>

        <mxCell id="se1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se4" value="가능 · 판정불가" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#9673a6;fontSize=10;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="se6" value="불가능 → 근거만" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;fontSize=10;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="s4" target="s6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="770" y="330" /><mxPoint x="1340" y="330" /></Array></mxGeometry></mxCell>
        <mxCell id="se7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;dashed=1;" edge="1" parent="1" source="s2" target="todo"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

