        <mxCell id="ddb1" value="DynamoDB CriteriaStore&#10;공고 기준 · review_status&#10;pending_review / approved / rejected" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;size=10;" vertex="1" parent="1">
