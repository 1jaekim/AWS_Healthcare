# Copy to backend/api/.env for local Bedrock integration.
# Never store AWS access keys in this file; use an AWS profile or IAM role.
BEDROCK_ENABLED=true
AWS_REGION=ap-northeast-2
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_MAX_TOKENS=1536
AGENT_MAX_ITERATIONS=4
# 추천 공고를 동시에 판정할 개수. 1이면 기존 순차 실행, 허용 범위는 1~5.
RECOMMENDATION_MAX_WORKERS=2

# ─── 인증 (Amazon Cognito) ────────────────────────────────────
# cdk deploy HealthcareAuthStack 출력값을 넣는다.
#   UserPoolId       -> COGNITO_USER_POOL_ID
#   UserPoolClientId -> COGNITO_CLIENT_ID   (쉼표로 여러 개 허용)
# 두 값이 채워지면 /api/v1/* 가 Cognito 토큰을 요구한다.
# 비워두면 개방 모드로 뜨고, 그 사실이 기동 로그에 경고로 남는다.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# 관리자 전용 API(코호트·검토 큐·감사 로그·근거 패널)의 판단 기준이 되는
# Cognito 그룹 이름. AuthStack 이 만드는 그룹 이름과 같아야 한다.
COGNITO_ADMIN_GROUP=admin

# true 면 위 설정이 비었을 때 개방 모드로 내려앉지 않고 요청을 거부한다.
# 배포 환경에서는 반드시 켠다. 설정 누락이 무인증 배포가 되지 않게 하는 장치다.
AUTH_REQUIRED=false
