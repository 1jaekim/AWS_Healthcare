{
  "Comment": "레거시 임상 데이터 정제 파이프라인. GraphRAG에는 환자 문서를 적재하지 않는다.",
  "StartAt": "Sanitizer",
  "States": {
    "Sanitizer": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${SanitizerFunctionArn}",
        "Payload": {"source_key": "raw/clinical_notes.jsonl"}
      },
      "ResultPath": "$.sanitizer_result",
      "ResultSelector": {
        "status.$": "$.Payload.status",
        "canonical_output.$": "$.Payload.canonical_output",
        "output_key.$": "$.Payload.output_key"
      },
      "Retry": [{
        "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException"],
        "IntervalSeconds": 30,
        "MaxAttempts": 3,
        "BackoffRate": 2.0
      }],
      "Catch": [{
        "ErrorEquals": ["States.ALL"],
        "Next": "PipelineFailedAlert",
        "ResultPath": "$.error"
      }],
      "Next": "PipelineSuccess"
    },
    "PipelineSuccess": {"Type": "Succeed"},
    "PipelineFailedAlert": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${AlertTopicArn}",
        "Subject": "[Healthcare Pipeline] 임상 데이터 정제 실패",
        "Message.$": "States.Format('임상 데이터 정제 파이프라인 실패: {}', $)"
      },
      "Next": "PipelineFailed"
    },
    "PipelineFailed": {
      "Type": "Fail",
      "Cause": "임상 데이터 정제 중 오류 발생",
      "Error": "ClinicalDataPipelineError"
    }
  }
}
