# 배포 빌드에 쓰이는 값. `vite build` 는 production 모드로 돌기 때문에 이 파일이
# `.env` 보다 우선한다.
#
# 이 파일이 있어야 하는 이유: `scripts/deploy-s3.sh` 와 Amplify 는 각자 안에서
# `npm run build` 를 다시 돌린다. 값을 셸 환경 변수로만 넘기면 그 재빌드에는
# 전달되지 않아서, 목업 모드로 빌드된 번들이 조용히 배포된다. 실제로 한 번
# 그렇게 나갔다.
#
# 여기 있는 값은 비밀이 아니다. 전부 브라우저 번들에 그대로 실려 나가는 공개
# 식별자다. Cognito 클라이언트에 시크릿을 두지 않은 것도 같은 이유다
# (`backend/infra/auth_stack.py`).

# API Lambda Function URL (cdk deploy HealthcareApiStack 의 ApiUrl)
VITE_API_BASE_URL=https://3fotb3ilzmnopf6gvflmequl440rmaxi.lambda-url.ap-northeast-2.on.aws

# 배포본은 실제 백엔드를 본다.
VITE_USE_MOCK=false

# 데모 계정이 바인딩될 person_id. 현재 배포된 API 는 시드 데이터셋(환자 1~3)을
# 읽는다 — `backend/scripts/generate_seed_dataset.py`.
VITE_DEMO_PERSON_ID=1

# 인증은 실제 Cognito User Pool 을 쓴다.
VITE_AUTH_PROVIDER=cognito
VITE_COGNITO_USER_POOL_ID=ap-northeast-2_M9srfkUaM
VITE_COGNITO_CLIENT_ID=12tvibdc3s1lc7f5ep4c5h0dko
