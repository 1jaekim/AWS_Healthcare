# Vite 는 빌드 시점에 이 값을 번들에 굽는다. S3/Amplify 는 정적 호스팅이라
# 배포 후에 바꿀 수 없다. 값을 바꾸면 반드시 다시 빌드해야 한다.

# 백엔드 FastAPI 주소. 로컬은 uvicorn 기본값.
VITE_API_BASE_URL=http://127.0.0.1:8000

# true 면 네트워크 호출 없이 목업 데이터로 동작한다.
# outputs/longitudinal_emr_v2 데이터셋이 없어 백엔드가 뜨지 않는 환경,
# 그리고 백엔드 배포 전 Amplify 미리보기에서 쓴다.
VITE_USE_MOCK=true

# 데모 계정이 바인딩될 합성 EMR 환자 번호.
# 백엔드 API 가 전부 person_id 로 말하므로 계정과 이어줄 값이 필요하다.
VITE_DEMO_PERSON_ID=1

# 인증 방식: cognito 또는 local
#   cognito — 아키텍처 v2 의 목표 구성. 아래 두 값이 반드시 필요하다.
#   local   — localStorage 자리표시자. User Pool 없이 화면을 돌려볼 때.
# cognito 인데 값이 비어 있으면 앱이 즉시 실패한다 (조용히 local 로 내려앉지 않는다).
VITE_AUTH_PROVIDER=local

# cdk deploy HealthcareAuthStack 의 출력값을 넣는다.
#   UserPoolId       -> VITE_COGNITO_USER_POOL_ID
#   UserPoolClientId -> VITE_COGNITO_CLIENT_ID
#
# 같은 값을 백엔드에도 넣어야 한다 (backend/api/.env 의 COGNITO_USER_POOL_ID,
# COGNITO_CLIENT_ID). 백엔드가 이 토큰을 검증하므로, 프론트만 cognito 로 두면
# API 는 무인증으로 열려 있고, 백엔드만 설정하면 local 제공자는 401 을 받는다.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
