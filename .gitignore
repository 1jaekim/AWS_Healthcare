cdk.out/
*.d.ts.map

# Node
node_modules/

# 로그
*.log

# 대용량 데이터 / 생성 산출물 (레포에 커밋하지 않음)
outputs/
synthea-data/
*.zip

# 크롤 결과 샘플 (실제 수집 데이터라 레포에 남기지 않음)
